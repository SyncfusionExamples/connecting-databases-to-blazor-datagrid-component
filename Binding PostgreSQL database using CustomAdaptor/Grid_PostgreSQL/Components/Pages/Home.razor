    /// <summary>
    /// Returns a CSS class name based on purchase order status to style the Status column template.
    /// </summary>
    private string GetStatusClass(PurchaseOrder data)
    {
        return data.Status?.ToLower() switch
        {
            "pending" => "status-pending",
            "approved" => "status-approved",
            "ordered" => "status-ordered",
            "received" => "status-received",
            "cancelled" => "status-cancelled",
            "completed" => "status-completed",
            _ => ""
        };
    }

    /// <summary>
    /// Returns a CSS class name based on item category to style the Category column template.
    /// </summary>
    private string GetCategoryClass(PurchaseOrder data)
    {
        return data.ItemCategory?.ToLower() switch
        {
            "electronics" => "category-electronics",
            "office supplies" => "category-office",
            "hardware" => "category-hardware",
            "software" => "category-software",
            "furniture" => "category-furniture",
            "networking" => "category-networking",
            "storage" => "category-storage",
            "accessories" => "category-accessories",
            "services" => "category-services",
            "other" => "category-other",
            _ => ""
        };
    }
